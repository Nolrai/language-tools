#!/usr/bin/env python3
import sys
import unicodedata
import re

def parse_arg(s):
    s = s.strip()
    if re.match(r'^[Uu]\+[0-9A-Fa-f]+$', s):
        return int(s[2:], 16)
    if s.startswith('0x') or s.startswith('0X'):
        return int(s, 16)
    if s.isdigit():
        return int(s, 10)
    # if it's a single character, return its codepointchm
    if len(s) == 1:
        return ord(s)
    raise SystemExit(f"Unrecognized input: {s}")

def info(cp):
    ch = chr(cp)
    try:
        name = unicodedata.name(ch)
    except ValueError:
        name = "<no name>"
    return cp, hex(cp), str(cp), ch, name

if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("usage: unicode_lookup.py <U+XXXX | 0xXXXX | DECIMAL | CHAR> [...]")
        raise SystemExit(1)
    for a in sys.argv[1:]:
        cp = parse_arg(a)
        c, h, d, ch, name = info(cp)
        print(f"{a} -> codepoint: {h} (dec {d}) char: '{ch}' name: {name}")